---
import { site } from '@/content/site';

interface Props {
  title: string;
  description: string;
  /** Set on pages that must stay out of the index, e.g. 404. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Absolute URLs are not optional here. Open Graph and canonical both require
// them, and the previous site shipped a relative og:image — which is why its
// link previews rendered without an image.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

// ProfilePage rather than a bare Person: Google's rich-results gallery does
// not list Person as a supported type. `sameAs` is the part that actually
// earns its keep, tying this site to the external profiles as one identity.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    description: site.bio[0],
    image: ogImage.href,
    jobTitle: site.jobTitle,
    url: Astro.site?.href,
    sameAs: site.profiles.map((link) => link.href),
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="google-site-verification" content={site.googleSiteVerification} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content="srikoushik.github.io" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />

{/* `summary`, not `summary_large_image`: the current image is square. */}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(structuredData)}
/>
