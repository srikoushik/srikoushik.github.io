---
import type { SocialLink } from '@/content/site';

interface Props {
  links: SocialLink[];
}

const { links } = Astro.props;
---

{
  links.length > 0 && (
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={link.event}
            class="decoration-muted-foreground/40 hover:decoration-foreground underline underline-offset-4 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
