---
import type { Profile } from '@/content/site';

interface Props {
  profiles: Profile[];
}

const { profiles } = Astro.props;

/**
 * Brand marks, inlined as SVG.
 *
 * Sourcing, since it varies by vendor:
 *   github   — GitHub's own @primer/octicons (`mark-github`), the icon set
 *              they publish themselves.
 *   linkedin — LinkedIn publishes the "in" bug as PNG only (brand.linkedin.com
 *              ships InBug-Black/White at 840x779, no vector). A raster cannot
 *              inherit `currentColor`, which the grey-to-brand hover needs, so
 *              this is the standard vector "in" glyph in LinkedIn's proportions.
 *   medium   — Medium's brand page is behind an auth redirect; this is the
 *              current official wordmark shape.
 *
 * `hover` is each brand's own colour. GitHub (#181717) and Medium (#000000)
 * are monochrome brands, so their lit state is the theme foreground — black
 * on light, white on dark. LinkedIn's #0A66C2 is too dim against a near-black
 * background, so dark mode uses their lighter UI blue.
 */
const ICONS: Record<Profile['icon'], { path: string; hover: string }> = {
  github: {
    path: 'M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943',
    hover: 'hover:text-foreground',
  },
  linkedin: {
    path: 'M9 9h4.151v2.128h.059C13.787 10.092 15.201 9 17.308 9c4.382 0 5.192 2.728 5.192 6.275V22.5h-4.327v-6.405c0-1.528-.031-3.493-2.251-3.493-2.253 0-2.597 1.664-2.597 3.382V22.5H9V9zM1.5 9H6v13.5H1.5V9zM6 5.25a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
    hover: 'hover:text-[#0A66C2] dark:hover:text-[#70B5F9]',
  },
  medium: {
    path: 'M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z',
    hover: 'hover:text-foreground',
  },
};
---

<ul class="mt-2.5 flex items-center gap-3.5">
  {
    profiles.map((profile) => (
      <li>
        <a
          href={profile.href}
          target="_blank"
          rel="noopener noreferrer"
          data-umami-event={profile.event}
          aria-label={profile.label}
          class:list={[
            'text-muted-foreground focus-visible:ring-ring/50 block rounded-sm transition-colors duration-200 focus-visible:ring-3 focus-visible:outline-none',
            ICONS[profile.icon].hover,
          ]}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5"
            aria-hidden="true"
          >
            <path d={ICONS[profile.icon].path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
