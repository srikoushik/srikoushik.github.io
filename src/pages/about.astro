---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LabeledRows from '@/components/LabeledRows.astro';
import OutboundLink from '@/components/OutboundLink.astro';
import { site } from '@/content/site';
import { inlineImage } from '@/lib/inline-image';

// 164px is the 82px box at 2x. Inlined rather than fetched — see `inline-image`.
const avatar = await inlineImage('me.jpg', 164);

/**
 * The About view.
 *
 * A real route rather than the prototype's in-place view swap: this is the
 * page carrying the actual prose, so it needs to be linkable, crawlable and
 * countable as its own pageview. The prototype toggled state because a design
 * canvas has no router — the visual result is identical.
 */
---

<BaseLayout
  title={`About — ${site.name}`}
  description={site.aboutDescription}
>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-[660px] flex-col gap-[34px] px-[26px] pt-[56px] pb-[44px] sm:gap-[44px] sm:px-0 sm:pt-[76px] sm:pb-[60px]"
  >
    {/*
      The way back sits above the content rather than after it: on a page this
      short the reader meets it before committing to the scroll, and it no
      longer competes with the outbound links at the foot. Tracked, but in
      sentence case rather than the eyebrow's caps — it reads as a control,
      not a label.
    */}
    <a
      href="/"
      data-umami-event="about-nav-home"
      class="text-muted-foreground hover:text-foreground -mt-[14px] flex min-h-[48px] w-fit items-center gap-[0.5em] text-[12px] tracking-[0.2em] transition-colors sm:mt-0 sm:min-h-0 sm:px-[2px] sm:text-[13px]"
    >
      <span aria-hidden="true">←</span>Home
    </a>

    <header class="flex items-center gap-[16px] sm:gap-[22px]">
      {/* Inline bytes, so decode synchronously — see the note on the home card. */}
      <img
        src={avatar}
        alt={`Portrait of ${site.name}`}
        width={82}
        height={82}
        decoding="sync"
        class="shadow-float-sm size-[62px] shrink-0 rounded-full object-cover sm:size-[82px]"
      />
      <div class="flex flex-col gap-[6px] sm:gap-[7px]">
        <p
          class="text-faint text-[10px] tracking-[0.22em] uppercase sm:text-[11px]"
        >
          About
        </p>
        <h1
          class="text-[30px] leading-none font-medium tracking-[-0.015em] sm:text-[42px]"
        >
          {site.name}
        </h1>
      </div>
    </header>

    <div
      class="flex flex-col gap-[20px] text-[17px] leading-[1.68] text-pretty sm:gap-[26px] sm:text-[20px] sm:leading-[1.72]"
    >
      {
        site.bio.map((paragraph) => (
          <p>
            {paragraph.lead && (
              <strong class="font-semibold">{paragraph.lead}</strong>
            )}
            {paragraph.lead ? ` ${paragraph.text}` : paragraph.text}
          </p>
        ))
      }
    </div>

    {/*
      Interests before the stack, so the page descends from what I've done to
      what I'm doing to who I am, and only then to what I use. The stack is the
      footnote — four rows of tooling read as the page's subject if they sit
      directly under the prose, where attention is highest.
    */}
    <LabeledRows title="Interests" rows={site.interests} />

    <LabeledRows title="Tech stack" rows={site.stack} />

    {/*
      `mt-auto` pins the footer to the bottom of a short mobile viewport, as
      the design does. From `sm` it sits directly under the content instead,
      where the column is centred and the page is read top-to-bottom.
    */}
    <nav
      class="border-border mt-auto flex flex-col gap-[10px] border-t pt-[22px] text-[14px] sm:mt-0 sm:flex-row sm:items-end sm:gap-[26px] sm:pt-[14px] sm:text-[15px]"
      aria-label="About"
    >
      {
        site.aboutLinks.map((link) => (
          <OutboundLink link={link} class="sm:py-[8px]" />
        ))
      }
    </nav>
  </main>
</BaseLayout>
