---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
---

<BaseLayout
  title="Koushik"
  description="A personal portfolio to share my interests, experience, blog and also to get connected with my active social platforms."
>
  <main class="mx-auto max-w-2xl px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Koushik</h1>
    <p class="text-muted-foreground mt-2">Software engineer.</p>
    <Button className="mt-6">Static render probe</Button>
  </main>
</BaseLayout>
