---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/content/site';
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="That page does not exist."
  noindex
>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6">
    <p class="text-muted-foreground text-sm font-semibold tracking-widest uppercase">
      404
    </p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">Page not found</h1>
    <p class="text-muted-foreground mt-3 leading-relaxed">
      That page does not exist — it may have moved, or the link may be wrong.
    </p>
    <p class="mt-6">
      <a
        href="/"
        class="decoration-muted-foreground/40 hover:decoration-foreground underline underline-offset-4 transition-colors"
      >
        Back to the homepage
      </a>
    </p>
  </main>
</BaseLayout>
