---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/content/site';
---

<BaseLayout
  title={`Page not found — ${site.name}`}
  description="That page does not exist."
  noindex
>
  <main
    class="mx-auto flex min-h-dvh w-full max-w-[660px] flex-col justify-center gap-[14px] px-[26px] sm:px-0"
  >
    <p class="text-faint text-[10px] tracking-[0.22em] uppercase sm:text-[11px]">
      404
    </p>
    <h1
      class="text-[30px] leading-none font-medium tracking-[-0.015em] sm:text-[42px]"
    >
      Page not found
    </h1>
    <p
      class="text-muted-foreground mt-[6px] text-[17px] leading-[1.68] text-pretty sm:text-[20px] sm:leading-[1.72]"
    >
      That page does not exist — it may have moved, or the link may be wrong.
    </p>
    <p class="mt-[14px] text-[14px] sm:text-[15px]">
      <a
        href="/"
        class="border-border text-muted-foreground hover:text-foreground inline-block border-b px-[2px] py-[8px] leading-[1.4] transition-colors"
      >
        ← Back home
      </a>
    </p>
  </main>
</BaseLayout>
