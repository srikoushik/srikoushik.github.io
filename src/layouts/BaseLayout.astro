---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

// Imported for its hashed build URL so the font can be preloaded. Without
// this the browser only discovers it after parsing the stylesheet, which
// delays first text paint — and this design is entirely type, so a late font
// is a late page.
//
// Now that the stylesheet is inlined the gap is smaller than it was, but not
// gone: the preload sits in the first 500 bytes of the document, ahead of
// ~16 KB of CSS the parser would otherwise have to get through first.
import newsreaderLatin from '@/assets/newsreader-latin-subset.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex } = Astro.props;

// Umami Cloud. Emitted only in production builds and only when an ID is
// configured, so local development never pollutes the data — the intent
// behind the old analytics module's isLocalhost guard.
//
// PUBLIC_UMAMI_WEBSITE_ID is a repository variable, read by deploy.yml.
// Without it the site simply ships no tracker.
//
// Do not keep it in a local `.env`. The PROD guard means it cannot switch the
// tracker on under `astro dev` anyway, and `npm test` builds for production
// and asserts the tracker is absent — so a populated `.env` fails a correct
// build. To exercise it locally, pass it for one command:
// `PUBLIC_UMAMI_WEBSITE_ID=... npm run build`.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const trackingEnabled = import.meta.env.PROD && Boolean(umamiWebsiteId);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={newsreaderLatin}
      crossorigin
    />
    {/*
      Both themes paint a warm surface, so the browser UI (address bar,
      overscroll) should follow rather than stay stock white. sRGB conversions
      of the design's pageBg — `theme-color` predates oklch support.
    */}
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f9f6f2"
    />
    {/*
      The tracker is the only cross-origin request either page makes, and it
      pays for the whole handshake: measured at 186ms to connect and 355ms to
      negotiate TLS, against ~11ms and ~25ms for the already-open connection
      to the origin. Opening it early overlaps that with parsing rather than
      starting it when the deferred script runs.

      No `crossorigin`: a classic `<script src>` is fetched in no-cors mode,
      and a preconnect only warms the connection it matches. The font preload
      above does need it, which is why the two differ.

      Behind the same guard as the script — preconnecting to a host this build
      never contacts would be a wasted DNS and TLS round trip on every load.
    */}
    {trackingEnabled && <link rel="preconnect" href="https://cloud.umami.is" />}

    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#26221e"
    />
    <Seo title={title} description={description} noindex={noindex} />

    {/*
      Resolves the theme synchronously during head parsing, before the body
      exists. Deferring this to a bundled script would paint a light frame
      first and then correct it — a visible flash on every load.
    */}
    <script is:inline>
      (function () {
        var preference = 'system';
        try {
          preference = window.localStorage.getItem('theme') || 'system';
        } catch (error) {
          /* storage blocked — fall back to system */
        }
        var dark =
          preference === 'dark' ||
          (preference === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>

    {/*
      `data-performance` turns on Core Web Vitals collection (TTFB, FCP, LCP,
      CLS, INP), which surfaces on Umami's Performance page. It costs nothing
      extra: the collector already ships inside the tracker script this page
      loads either way, and enabling it adds no request and no bytes.

      The value must be the literal string "true" — the tracker compares
      against it exactly, so "1" or a bare attribute silently collects
      nothing. `tests/analytics.spec.ts` builds with an ID and asserts it.
    */}
    {
      trackingEnabled && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiWebsiteId}
          data-performance="true"
        />
      )
    }
  </head>
  <body>
    {/*
      Fixed rather than in flow, so it cannot disturb the centring of the page
      beneath it. Offsets are the design's: tighter on mobile, where the
      control also grows to clear the 44px tap-target minimum.
    */}
    <div class="fixed top-[18px] right-[18px] z-10 sm:top-[28px] sm:right-[30px]">
      <ThemeToggle />
    </div>
    <slot />
  </body>
</html>
